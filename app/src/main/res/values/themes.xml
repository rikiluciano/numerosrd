<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema principal de la app (dark) -->
    <style name="Theme.LotteryRD" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/toolbar_bg</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Tema para la Splash Activity (sin ActionBar) -->
    <style name="Theme.LotteryRD.Splash" parent="Theme.LotteryRD">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>

    <!-- NoActionBar para actividades con Toolbar manual -->
    <style name="Theme.LotteryRD.NoActionBar" parent="Theme.LotteryRD">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
